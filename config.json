{
    "cflags": ["-O2", "-g", "-std=c++17", "-lm", "-pedantic", "-DALGME"],
    "def_file": "def.toml",
    "statistics_file_name": "time.cvs",
    "manual_testcases_folder_name": "_manual",
    "problem_tmp_folder": ".tmp",
    "extensions": [".cpp", ".py", ".sh"],
