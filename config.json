{
    "def_file": "def.toml",
    "statistics_file_name": "time.cvs",
    "manual_testcases_folder_name": "_manual",
    "problem_tmp_folder": ".tmp",
    "extensions": [".cpp", ".py", ".sh"],
    "in_ext": ".in",
    "out_ext": ".out",
    "enable_cache": true,
    "logging_level": 20,
    "languages": {
        "interpreted": {
            "py": "python3",
            "sh": "sh"
        },
        "compiled": [
            {
                "extensions": ["c", "cpp", "C"],
                "command": "g++ -O2 -g -std=c++17 -lm -pedantic -D{flag} -o {exe} {source}"
            }, {
                "extensions": ["java"],
                "command": "javac -d {build} {source}",
                "run": "java -cp {build} {class}",
                "artifact": "{build}/{class}.class"
            }
        ]
    },
    "file_structure": {
        "generator": "gen",
        "validator": "val",
        "painter": "pic",
        "judge": "jud",
        "solution": "sol",
        "checker": "chk"
    },
    "time_limit_seconds": 30
}
